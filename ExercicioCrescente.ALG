Algoritmo "semnome"


Var

 x, y : inteiro

Inicio

 escreval("Digite um par de numeros")
 leia(x)
 leia(y)
 
 enquanto x <> y faca
 
 se x > y entao
   escreval("DECRESCENTE!")
  senao
   escreval("CRESCENTE")
 fimse
 escreval("Digite outro par de números")
  leia(x)
  leia(y)
 fimenquanto
 


Fimalgoritmo